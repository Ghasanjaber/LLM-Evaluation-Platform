# Copy this file to .env.local and fill in your keys.
# .env.local is gitignored — never commit real keys.

# Used by the Cascade Router (both tiers) and by gpt-4 / gpt-3.5-turbo in
# comparison mode. Set this one first — the router needs it.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Used for claude-opus-5 in comparison mode
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Used for gemini-1.5-pro — https://aistudio.google.com/apikey
GOOGLE_API_KEY=
